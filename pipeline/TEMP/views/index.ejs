<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Brand Group Approver</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div>
        <h1>Brand Group Approver</h1>
        <p class="sub">
          Showing tentative groups with brands already aggregated removed.
        </p>
      </div>

      <div class="stats">
        <div class="stat"><div class="k">grouped.json</div><div class="v"><%= stats.groupedCount %></div></div>
        <div class="stat"><div class="k">grouped_test.json</div><div class="v"><%= stats.tentativeCount %></div></div>
        <div class="stat"><div class="k">displaying</div><div class="v"><%= stats.displayCount %></div></div>
      </div>
    </header>

    <main class="container">
      <% if (Object.keys(displayGroups).length === 0) { %>
        <div class="empty">
          Nothing to review — either grouped_test.json is empty, or everything was filtered out as already aggregated.
        </div>
      <% } %>

      <div class="grid">
  <% if (displayGroups.length === 0) { %>
    <div class="empty">
      Nothing to review — either grouped_test.json is empty,
      or everything was filtered out as already aggregated.
    </div>
  <% } %>

  <% for (const group of displayGroups) { %>
    <% const canonical = group.canonical; %>
    <% const members = group.members; %>

    <section class="card" data-canonical="<%- canonical %>">
      <div class="card-head">
        <div>
          <div class="title"><%- canonical %></div>
          <div class="meta"><%= members.length %> remaining candidate(s)</div>
        </div>

        <div class="actions">
          <button class="btn approve" data-action="approve">Approve</button>
          <button class="btn reject" data-action="reject">Reject</button>
        </div>
      </div>

      <ul class="members">
  <% for (const m of members) { %>
    <li>
      <button type="button" class="chip" data-brand="<%- m %>">
        <code><%- m %></code>
      </button>
    </li>
  <% } %>
</ul>

      <div class="status" aria-live="polite"></div>
    </section>
  <% } %>
</div>
    </main>

    <script src="/app.js"></script>
  </body>
</html>